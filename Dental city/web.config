<?xml version="1.0" encoding="utf-8"?>
<!--
  Dental City Clinic Management & Booking System
  Subfolder Web Configuration
-->
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
    <handlers>
      <add name="iisnode" path="dist/server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^dist/server.js\/debug[\/]?" />
        </rule>
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+[.](html|htm|svg|js|css|png|gif|jpg|jpeg|ico|woff|woff2|ttf|eot|webp))" />
          <action type="Rewrite" url="public/{R:1}" />
        </rule>
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="dist/server.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="src" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <iisnode
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      initialRequestTimeout="60000"
      requestTimeout="120000"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="false"
      loggingEnabled="true"
      watchedFiles="web.config;*.js"
    />
  </system.webServer>
</configuration>

