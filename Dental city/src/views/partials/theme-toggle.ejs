<%
  const toggleId = (typeof idPrefix !== 'undefined') ? idPrefix : 'themeToggleBtn';
  const isCompact = (typeof compact !== 'undefined') ? compact : false;
%>

<div class="dropdown theme-toggle-dropdown" dir="rtl">
    <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 d-flex align-items-center gap-1 theme-toggle-btn" 
            type="button" 
            id="<%= toggleId %>" 
            data-bs-toggle="dropdown" 
            aria-expanded="false" 
            title="تبديل مظهر النظام (فاتح / داكن / تزامن تلقائي)"
            aria-label="تبديل مظهر النظام">
        <i class="bi bi-circle-half theme-icon-active fs-6 text-secondary"></i>
        <% if (!isCompact) { %>
            <span class="d-none d-sm-inline small fw-semibold theme-text-label">تلقائي</span>
        <% } %>
        <i class="bi bi-chevron-down small opacity-50 ms-1" style="font-size: 0.65rem;"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow-sm border rounded-3 text-end py-2" aria-labelledby="<%= toggleId %>">
        <li>
            <button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-2" data-theme-value="light">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-sun-fill text-warning fs-6"></i>
                    <span>الوضع النهاري (فاتح)</span>
                </span>
                <i class="bi bi-check2 theme-check d-none text-primary"></i>
            </button>
        </li>
        <li>
            <button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-2" data-theme-value="dark">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-moon-stars-fill text-info fs-6"></i>
                    <span>الوضع الليلي (داكن)</span>
                </span>
                <i class="bi bi-check2 theme-check d-none text-primary"></i>
            </button>
        </li>
        <li><hr class="dropdown-divider my-1"></li>
        <li>
            <button type="button" class="dropdown-item d-flex align-items-center justify-content-between py-2 active" data-theme-value="auto">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-circle-half text-secondary fs-6"></i>
                    <span>تزامن النظام تلقائياً (Auto)</span>
                </span>
                <i class="bi bi-check2 theme-check text-primary"></i>
            </button>
        </li>
    </ul>
</div>
