                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0">ورديتان (صباحي/مسائي)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Operational Details Row -->
