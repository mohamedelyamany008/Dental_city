            </div>
            <form method="post" action="/Doctor/Dashboard?handler=SaveDoctor" id="doctorModalForm">
                <input type="hidden" name="id" id="modalDocId" value="0" />
                <div class="modal-body p-4">
                    <!-- 1. البيانات الأساسية والمهنية -->
