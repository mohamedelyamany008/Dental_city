            alertEl.className = "alert alert-danger mb-3";
            alertEl.textContent = "حدث خطأ في الاتصال أثناء حفظ كلمة المرور.";
            alertEl.classList.remove("d-none");
        } finally {
            saveBtn.disabled = false;
