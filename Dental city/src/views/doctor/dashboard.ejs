                                <div class="overview-kpi-icon bg-info-subtle text-info">
                                    <i class="bi bi-activity"></i>
                                </div>
                                <div class="min-w-0 flex-grow-1">
                                    <div class="overview-kpi-title">كفاءة التشغيل والجاهزية</div>
